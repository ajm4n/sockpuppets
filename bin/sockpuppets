#!/bin/bash
# SockPuppets C2 — CLI entry point
# Installed to /usr/local/bin by setup.sh

set -e

INSTALL_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
VENV="$INSTALL_DIR/.venv"

if [ ! -d "$VENV" ]; then
    echo "[-] Virtual environment not found at $VENV"
    echo "    Run: cd $INSTALL_DIR && ./setup.sh --python"
    exit 1
fi

PYTHON="$VENV/bin/python3"
if [ ! -x "$PYTHON" ]; then
    echo "[-] Python not found in venv"
    echo "    Run: cd $INSTALL_DIR && ./setup.sh --python"
    exit 1
fi

show_help() {
    echo "SockPuppets C2 Framework"
    echo ""
    echo "Usage: sockpuppets <command> [options]"
    echo ""
    echo "Commands:"
    echo "  cli                        Interactive CLI (default)"
    echo "  tui [--connect HOST:PORT]  Terminal UI (Textual)"
    echo "  gui [port] [--connect HOST:PORT]  Web GUI (default port: 13337)"
    echo "  setup [flags]              Run setup.sh (pass --check, --python, etc.)"
    echo "  server                     Start server only (no UI)"
    echo "  generate                   Generate payloads (interactive)"
    echo "  version                    Show version info"
    echo "  help                       Show this help"
    echo ""
    echo "Remote connection:"
    echo "  --connect HOST:PORT  Connect to a remote SockPuppets server"
    echo "                       TUI: opens TUI against remote server API"
    echo "                       GUI: opens browser to remote server GUI"
}

# Parse --connect from arguments (works for both tui and gui)
parse_connect() {
    local args=("$@")
    for ((i=0; i<${#args[@]}; i++)); do
        case "${args[i]}" in
            --connect=*) echo "${args[i]#--connect=}"; return ;;
            --connect)
                if [ $((i+1)) -lt ${#args[@]} ]; then
                    echo "${args[$((i+1))]}"; return
                fi
                ;;
        esac
    done
}

case "${1:-cli}" in
    cli)
        exec "$PYTHON" "$INSTALL_DIR/main.py"
        ;;
    tui)
        shift
        connect=$(parse_connect "$@")
        if [ -n "$connect" ]; then
            exec "$PYTHON" "$INSTALL_DIR/main.py" --tui --connect "$connect"
        else
            exec "$PYTHON" "$INSTALL_DIR/main.py" --tui
        fi
        ;;
    gui)
        shift
        connect=$(parse_connect "$@")
        if [ -n "$connect" ]; then
            url="http://$connect"
            echo "[*] Connecting to remote SockPuppets GUI: $url"
            if command -v xdg-open &>/dev/null; then
                xdg-open "$url" 2>/dev/null
            elif command -v open &>/dev/null; then
                open "$url" 2>/dev/null
            elif command -v wslview &>/dev/null; then
                wslview "$url" 2>/dev/null
            else
                echo "[+] Open in browser: $url"
            fi
            exit 0
        fi
        # Parse port from remaining args (first numeric arg)
        port="13337"
        for arg in "$@"; do
            case "$arg" in
                [0-9]*) port="$arg"; break ;;
            esac
        done
        exec "$PYTHON" "$INSTALL_DIR/main.py" --gui "$port"
        ;;
    setup)
        shift
        exec bash "$INSTALL_DIR/setup.sh" "$@"
        ;;
    server)
        exec "$PYTHON" -c "
import asyncio
from server import SockPuppetsServer
server = SockPuppetsServer()
print('[*] SockPuppets server running. Ctrl+C to stop.')
try:
    asyncio.get_event_loop().run_forever()
except KeyboardInterrupt:
    print('\n[*] Stopped.')
"
        ;;
    generate)
        exec "$PYTHON" -c "
from agent import AgentGenerator
import sys
gen = AgentGenerator()
print('SockPuppets Payload Generator')
print('Available: python, go, rust, csharp, c')
lang = input('Language [python]: ').strip() or 'python'
host = input('C2 host: ').strip()
port = input('C2 port [443]: ').strip() or '443'
result = gen.generate_all(c2_host=host, c2_port=int(port))
for name, path in result.items():
    print(f'  [+] {name}: {path}')
"
        ;;
    version|-v|--version)
        echo "SockPuppets C2"
        echo "Install: $INSTALL_DIR"
        "$PYTHON" --version 2>&1
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
